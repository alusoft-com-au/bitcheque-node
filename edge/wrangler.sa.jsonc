// A fifth node, in South America (São Paulo), deployed as its own Worker so the three in wrangler.jsonc are not touched:
//   npx wrangler deploy -c wrangler.sa.jsonc
// It is one of five nodes in a mesh: it pushes what it accepts to the other four and pulls from them every 3 minutes,
// reaching them through service bindings to their Workers (UPSTREAMS: nearest first). It does not mine.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "bitcheque-node-sa",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "durable_objects": { "bindings": [{ "name": "NODE", "class_name": "EdgeNode" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EdgeNode"] }],
  "services": [{ "binding": "NODE_MAIN", "service": "bitcheque-node" }, { "binding": "NODE_OC", "service": "bitcheque-node-oc" }],
  "triggers": { "crons": ["*/30 * * * *"] },
  // the public's uncached requests: at most 300 a minute per address (peers, with EDGE_SECRET, are not limited);
  // /check and /template (the costliest) also at most 30 a minute
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
                 { "name": "RL_HEAVY", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }],
  "routes": [{ "pattern": "node-sa.bitcheque.org", "custom_domain": true }],
  "vars": { "NET": "0", "REGIONS": "{\"sa\":\"sam\"}",
            "UPSTREAMS": "https://node-us.bitcheque.org,https://node-eu.bitcheque.org,https://node-ap.bitcheque.org,https://node-oc.bitcheque.org",
            "SERVICES": "{\"node-ap.bitcheque.org\":\"NODE_MAIN\",\"node-us.bitcheque.org\":\"NODE_MAIN\",\"node-eu.bitcheque.org\":\"NODE_MAIN\",\"node-oc.bitcheque.org\":\"NODE_OC\"}",
            "MINE_REGIONS": "", "MINER_ID": "", "SYNC_S": "180" }
}
