// A fourth node, in Oceania (Sydney), deployed as its own Worker so the three in wrangler.jsonc are not touched:
//   npx wrangler deploy -c wrangler.oc.jsonc
// It follows node-ap, node-us and node-eu as upstreams (pulls their blocks every minute, passes transactions on to
// them) through a service binding to their Worker, and does not mine.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "bitcheque-node-oc",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "durable_objects": { "bindings": [{ "name": "NODE", "class_name": "EdgeNode" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EdgeNode"] }],
  "services": [{ "binding": "UPSTREAM_SVC", "service": "bitcheque-node" }],
  "triggers": { "crons": ["*/30 * * * *"] },
  "routes": [{ "pattern": "node-oc.bitcheque.org", "custom_domain": true }],
  "vars": { "NET": "0", "REGIONS": "{\"oc\":\"oc\"}",
            "UPSTREAMS": "https://node-ap.bitcheque.org,https://node-us.bitcheque.org,https://node-eu.bitcheque.org",
            "MINE_REGIONS": "", "MINER_TO": "0" }
}
